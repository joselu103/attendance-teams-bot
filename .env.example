# Runtime observability metadata. APP_VERSION is set from the immutable image revision in deployment.
LOG_ENV=local
APP_VERSION=dev

# Select local, Teams callback-only, or authenticated attendance handling.
# Do not commit a populated .env file.
BOT_RUNTIME_MODE=local

# Use a URL reachable from this bot container, such as the example DNS name below.
# Do not use localhost for an MCP service in another container or on another machine.
MCP_ENDPOINT=https://attendance-mcp.example.test/mcp
ATTENDANCE_API_DELEGATED_SCOPE=api://<attendance-rest-api-app-id>/attendance.access
TEAMS_SSO_OAUTH_CONNECTION_NAME=
MCP_TIMEOUT_SECONDS=10

# Required only when BOT_RUNTIME_MODE=attendance. Keep the API key secret.
OPENAI_API_KEY=
OPENAI_MODEL=<approved-model-name>

# Optional bot-owned PostgreSQL conversation memory. Supply real credentials through
# the approved secret mechanism; synthetic examples only are committed here.
DATABASE_URL=
POSTGRES_DB=attendance_memory
POSTGRES_USER=attendance_memory
POSTGRES_PASSWORD=<synthetic-postgres-password>

# Required when BOT_RUNTIME_MODE is teams-only or attendance.
BOT_APP_ID=
BOT_TENANT_ID=
BOT_CLIENT_SECRET=

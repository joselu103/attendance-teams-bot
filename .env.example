# Runtime observability metadata. APP_VERSION is set from the immutable image revision in deployment.
LOG_LEVEL=INFO
APP_VERSION=dev

# Local development only. Do not commit a populated .env file.
BOT_RUNTIME_MODE=local

# Enable only after Teams SSO, OBO, and the remote Attendance CRMT MCP endpoint are configured.
ATTENDANCE_INTEGRATION_ENABLED=false
MCP_ENDPOINT=
MCP_SCOPE=
TEAMS_SSO_OAUTH_CONNECTION_NAME=
MCP_TIMEOUT_SECONDS=10

# Required only when ATTENDANCE_INTEGRATION_ENABLED=true. Keep the API key secret.
OPENAI_API_KEY=
OPENAI_MODEL=

# Required only when BOT_RUNTIME_MODE=teams.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
